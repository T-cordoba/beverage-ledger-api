# Copia este archivo a `.env` y rellena los valores.
# `.env` está gitignoreado: nunca commitees credenciales reales.

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3001"
API_PREFIX="api/v1"

# Orígenes permitidos por CORS, separados por coma. El front en local corre en :3000.
CORS_ORIGINS="http://localhost:3000"

# Swagger en /docs. Déjalo en "false" en producción.
SWAGGER_ENABLED="true"

# Rate limiting global.
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Son DOS conexiones distintas al mismo Postgres, y no son intercambiables:
#
#   DATABASE_URL  -> pooler en modo transacción (puerto 6543). La usa la aplicación
#                    en runtime a través del driver adapter de Prisma.
#   DIRECT_URL    -> conexión directa o pooler en modo sesión (puerto 5432). La usa
#                    la CLI de Prisma para las migraciones; el pooler en modo
#                    transacción no puede ejecutarlas.
#
# Si la contraseña contiene / % @ o :, hay que URL-encodearla (/ -> %2F, % -> %25,
# @ -> %40, : -> %3A) o la conexión falla con un error de parseo poco descriptivo.

DATABASE_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# `prisma migrate dev` necesita una base de sombra que pueda crear y destruir para
# detectar drift. El rol de aplicación de Supabase no puede crear bases, así que
# se usa el Postgres local de docker-compose:
#
#   docker compose up -d
#
# Alternativa sin Docker: crear una base `shadow` en Supabase desde el SQL editor
# (CREATE DATABASE shadow;) y apuntar aquí. Solo hace falta en desarrollo:
# `prisma migrate deploy` (producción) no usa base de sombra.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beverage_ledger_shadow"
