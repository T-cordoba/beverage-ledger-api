# Copy to `.env` and fill in. `.env` is gitignored: never commit real credentials.

NODE_ENV="development"
PORT="3001"
API_PREFIX="api/v1"

# Comma-separated allowlist.
CORS_ORIGINS="http://localhost:3000"
# Where the Google sign-in callback sends the browser back to.
FRONTEND_URL="http://localhost:3000"

# Set to "false" in production.
SWAGGER_ENABLED="true"

THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Access tokens are short because they are not revocable; the refresh token is.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

AUTH_COOKIE_NAME="bl_refresh"

LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"


# Read by the seed, not by the API. Empty leaves the seeded admin as INVITED and
# unable to sign in; set it and re-run `npm run db:seed` to give it a password.
SEED_ADMIN_PASSWORD=""

# Optional, and validated as a set: either all three or none. Empty disables
# Google sign-in and the API still boots. For local development the callback is
#   http://localhost:3001/api/v1/auth/google/callback
# which must match the URI registered in Google Cloud Console character for
# character — the number one source of failures in this flow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# Two connections to the same Postgres, and they are not interchangeable:
#   DATABASE_URL -> transaction-mode pooler (6543), used by the app at runtime
#   DIRECT_URL   -> direct or session-mode pooler (5432), used to run migrations
#
# Passwords containing / % @ or : must be URL-encoded (/ -> %2F, % -> %25).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# `prisma migrate dev` creates and drops a shadow database to detect drift, which
# Supabase's application role cannot do, so it points at `docker compose up -d`.
# Development only: `prisma migrate deploy` does not use one.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beverage_ledger_shadow"

# Account the white-box path tests read the organization from. Any user of the
# organization the tests should run against.
TEST_USER_EMAIL="admin@beverageledger.local"
