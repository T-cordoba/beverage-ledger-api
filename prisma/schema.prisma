// Models and fields are camelCase in English; tables and columns are snake_case
// via @map. Every business table carries organizationId so multi-tenancy is a
// feature to build, not a migration to survive.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// PLATFORM_ADMIN operates above the organization, for the future SaaS.
enum UserRole {
  PLATFORM_ADMIN
  ORG_ADMIN
  MANAGER
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
}

/// INBOUND adds stock, OUTBOUND subtracts, ADJUSTMENT corrects in either
/// direction and requires a reason.
enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

enum MovementStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Unit the user captured the line in. quantityBase normalizes it to singles.
enum MovementUnit {
  BOTTLE
  CASE
}

/// The tenant. All branding comes from here, never from constants in code.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  legalName String?  @map("legal_name")
  logoUrl   String?  @map("logo_url")
  timezone  String   @default("America/Bogota")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  categories       Category[]
  brands           Brand[]
  products         Product[]
  locations        Location[]
  movements        Movement[]
  movementCounters MovementCounter[]
  stockLevels      StockLevel[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  email           String
  name            String
  avatarUrl       String?    @map("avatar_url")
  /// Null for users who only sign in with Google.
  passwordHash    String?    @map("password_hash")
  role            UserRole   @default(OPERATOR)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  /// Reset on every successful sign-in. Feeds the lockout window below.
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identities       AuthIdentity[]
  refreshTokens    RefreshToken[]
  createdMovements Movement[]     @relation("MovementCreatedBy")
  auditLogs        AuditLog[]

  /// Email is unique per organization, not globally, so one person can belong to
  /// two businesses once the SaaS allows it.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// Lets a user hold both a password and Google instead of ending up with two
/// accounts for the same email.
model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

/// Stores the hash, never the token. revokedAt and replacedById support rotation
/// with reuse detection.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  name           String
  subcategory    String?
  /// Alcohol by volume, as a percentage.
  abv            Decimal? @db.Decimal(5, 2)
  origin         String?
  age            String?
  /// Singles per case. Normalizes quantities to base units.
  caseSize       Int      @default(12) @map("case_size")
  /// Reorder threshold. Null means no alert configured.
  minimumStock   Int?     @map("minimum_stock")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  movementItems MovementItem[]
  stockLevels   StockLevel[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@index([brandId])
  /// Trigram index so the catalogue search can stay server-side: a btree index
  /// cannot serve `name ILIKE '%term%'`, which is the query the search needs.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

/// Where stock lives. Seeded with a single row, which leaves multi-warehouse
/// modelled without building the interface for it yet.
model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    Movement[]
  stockLevels  StockLevel[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("locations")
}

model Movement {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  /// Human-readable code: MOV-2026-000123.
  code            String
  type            MovementType
  status          MovementStatus @default(DRAFT)
  locationId      String         @map("location_id") @db.Uuid
  /// When the movement happened, which need not be when it was recorded.
  occurredAt      DateTime       @map("occurred_at")
  /// Required at service level when type is ADJUSTMENT.
  reason          String?
  note            String?
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  confirmedAt     DateTime?      @map("confirmed_at")
  cancelledAt     DateTime?      @map("cancelled_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("MovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items        MovementItem[]

  @@unique([organizationId, code])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([createdByUserId])
  @@map("movements")
}

/// Draws the next number for `movements.code`, one row per organization and year.
///
/// A Postgres sequence would not do: it cannot be declared per tenant, and it
/// leaves gaps when a transaction rolls back. Incrementing this row inside the
/// creating transaction takes a row lock, which serializes numbering per
/// organization and year and keeps the series gapless.
model MovementCounter {
  organizationId String @map("organization_id") @db.Uuid
  year           Int
  nextSequence   Int    @default(1) @map("next_sequence")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@map("movement_counters")
}

/// The inventory source of truth. Name and brand snapshots keep a year-old PDF
/// faithful even after the product is renamed.
model MovementItem {
  id           String       @id @default(uuid()) @db.Uuid
  movementId   String       @map("movement_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  quantity     Int
  unit         MovementUnit
  /// quantity normalized to singles. The only thing that moves stock.
  quantityBase Int          @map("quantity_base")

  productNameSnapshot String  @map("product_name_snapshot")
  brandNameSnapshot   String? @map("brand_name_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([movementId])
  @@index([productId])
  @@map("movement_items")
}

/// Materialized projection of the ledger, updated in the same transaction that
/// confirms or cancels a movement and always rebuildable from movement_items.
model StockLevel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  /// Stock on hand, in singles.
  quantityBase   Int      @default(0) @map("quantity_base")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([organizationId])
  @@map("stock_levels")
}

/// userId is null for system actions.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}
